# Environment Configuration for APIx System
# Copy this file to .env and fill in the values

# Rate limiting (requests per second per domain)
RATE_LIMIT_PER_SECOND=1

# Token TTL in hours
TOKEN_TTL_HOURS=4

# Request timeout in seconds
REQUEST_TIMEOUT=30

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Supabase PostgreSQL (Supavisor pooler - port 6543)
SUPABASE_DB_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres

# Supabase Project
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Proxy configuration (for production)
# PROXY_URL=http://user:pass@proxy:port

# CAPTCHA solving service (Tier 3 - future)
# TWOCAPTCHA_API_KEY=your_api_key_here
